# Server-side NVIDIA API keys. Never prefix secrets with NEXT_PUBLIC_.
NVIDIA_NEMOTRON_API_KEY=
NVIDIA_KIMI_API_KEY=

# Optional CORS restriction for a separately hosted chat backend.
ALLOWED_ORIGIN=http://localhost:3000

# Optional browser configuration for GitHub Pages.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_CHAT_API_URL=
NEXT_PUBLIC_ENABLE_KIMI=false
